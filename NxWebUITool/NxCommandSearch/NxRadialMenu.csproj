<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 环形菜单入口：只含 Plugin，无 WinForms/WebView2 -->
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\deploy\application\</OutputPath>
    <AssemblyName>NxRadialMenu</AssemblyName>
    <RootNamespace>NxWebUITool</RootNamespace>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <PropertyGroup>
    <NxBase>E:\NX2506</NxBase>
    <NxManaged>$(NxBase)\NXBIN\managed</NxManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="EntryLoader.cs" />
    <Compile Include="RadialPlugin.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NXOpen">
      <HintPath>$(NxManaged)\NXOpen.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NXOpen.Utilities">
      <HintPath>$(NxManaged)\NXOpen.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
